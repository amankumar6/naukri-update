# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit real credentials.
#
# In GitHub Actions, these are provided via repo Secrets (not from .env).

# === PRIMARY: Cookie-based auth (works everywhere) ===
#
# Export your Naukri session cookies as JSON using a browser extension like
# "Cookie-Editor" (Chrome). Paste the JSON array as a single line below.
# See README.md for step-by-step export instructions.
#
# Cookies typically expire after ~30 days; re-export when the bot starts
# failing.
#
# Example shape (real values omitted):
# NAUKRI_COOKIES=[{"name":"nauk_at","value":"...","domain":".naukri.com","path":"/","secure":true,"httpOnly":true,"expirationDate":1234567890}]
NAUKRI_COOKIES=

# === FALLBACK: Email + password (LOCAL TESTING ONLY) ===
#
# Naukri's anti-bot blocks password login from datacenter IPs (GitHub Actions,
# AWS, etc.), so this only works from your local machine. If NAUKRI_COOKIES is
# set above, these are ignored.
NAUKRI_EMAIL=your-email@example.com
NAUKRI_PASSWORD=your-password
